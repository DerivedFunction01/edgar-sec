"""End-to-end projection smoke test."""
from edgar_sec.pipelines.document_inventory.cohort import (
    project_cohort, read_catalog_observations, CohortInputError,
    inventory_entry_id,
)
from edgar_sec.domain.identity import AccessionNumber, Cik
from datetime import date
import tempfile, json
from pathlib import Path


def main():
    with tempfile.TemporaryDirectory() as tmp:
        td = Path(tmp)
        (td / "filing_targets").mkdir()
        src = Path("tests/fixtures/catalog/cohort_observations.parquet")
        (td / "filing_targets" / "part-00000.parquet").write_bytes(src.read_bytes())
        (td / "snapshot.manifest.json").write_text(json.dumps({
            "catalog_id": "f259fde5d9c69335",
            "schema_version": "1.1.0",
            "target_row_count": 17,
            "parts": [{"part_index": 0, "path": "filing_targets/part-00000.parquet", "row_count": 17}],
        }))
        obs = list(read_catalog_observations(td, "plan-alpha", "catalog_snapshot"))
        assert len(obs) == 17, len(obs)
        cohort = project_cohort(obs, archive_base_url="https://www.sec.gov/Archives/edgar/data")
        assert len(cohort.accessions) == 8
        assert len(cohort.work_items) == 8
        assert len(cohort.sources) == 10

        # Accession A: two CIKs, dedup collapse, one work item
        a = cohort.accessions[0]
        assert str(a.accession) == "0000320193-23-000106"
        assert a.filing_cik == Cik(320193)
        assert a.source_ciks == (Cik(320193), Cik(789019))
        assert a.cohort_sources == ("plan-alpha",)
        assert a.form == "10-K" and a.filing_date == date(2023, 2, 1) and a.report_date == date(2022, 12, 31)

        # Legacy 1994 accession
        b = cohort.accessions[1]
        assert str(b.accession) == "0000950123-94-000687"
        assert b.filing_cik == Cik(950123)
        assert b.report_date == date(1993, 12, 31)

        # Accession C: two CIKs, missing report dates (non-conflicting)
        c = cohort.accessions[2]
        assert str(c.accession) == "0001326801-04-000077"
        assert c.source_ciks == (Cik(1326801), Cik(1652044))
        assert c.form == "8-K" and c.report_date is None

        # Archive CIK unpadded for 18-digit accession
        wi = cohort.work_items[7]
        assert str(wi.accession) == "0000009015-00-000054"
        assert wi.index_url == "https://www.sec.gov/Archives/edgar/data/9015/000000901500000054/-index.html"

        # Entry id determinism
        e1 = inventory_entry_id(AccessionNumber("0000320193-23-000106"), "document_format", 0, "deadbeef")
        e2 = inventory_entry_id(AccessionNumber("0000320193-23-000106"), "document_format", 0, "deadbeef")
        assert e1 == e2 and len(e1) == 64

        # Observation order (accession, source_cik, cohort_source_id)
        order = [(str(o.accession)[:10], str(o.source_cik), o.cohort_source_id) for o in cohort.observations]
        assert order == sorted(order), order

        print("ALL CHECKS PASSED")
        print("  accessions:", len(cohort.accessions), "work_items:", len(cohort.work_items), "sources:", len(cohort.sources))


if __name__ == "__main__":
    main()
